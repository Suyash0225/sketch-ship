GOOGLE_API_KEY=your-google-ai-studio-key-here

# Separate from GOOGLE_API_KEY above -- this must be a Cloud Vision API key
# (GCP project with "Cloud Vision API" enabled), used for real reverse-image
# web search. Leave unset to skip real web scanning (falls back to no-op).
GOOGLE_VISION_API_KEY=your-cloud-vision-api-key-here
